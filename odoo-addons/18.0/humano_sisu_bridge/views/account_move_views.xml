<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sisu" model="ir.ui.view">
        <field name="name">account.move.form.humano.sisu</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="humano_sisu" string="Humano SISU">
                    <field name="sisu_journal_entry_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
