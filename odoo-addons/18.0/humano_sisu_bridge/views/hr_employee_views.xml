<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_sisu" model="ir.ui.view">
        <field name="name">hr.employee.form.humano.sisu</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="humano_sisu" string="Humano SISU">
                    <field name="sisu_employee_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
