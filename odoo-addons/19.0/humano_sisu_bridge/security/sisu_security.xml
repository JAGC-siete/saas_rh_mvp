<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_humano_sisu" model="ir.module.category">
        <field name="name">Humano SISU</field>
        <field name="sequence">80</field>
    </record>
    <record id="privilege_bridge" model="res.groups.privilege">
        <field name="name">Humano SISU</field>
        <field name="sequence">80</field>
        <field name="category_id" ref="module_category_humano_sisu"/>
        <field name="description">API bridge: employees and draft payroll journal entries from Humano SISU.</field>
        <field name="placeholder">No</field>
    </record>
    <record id="group_bridge" model="res.groups">
        <field name="name">Bridge bot</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_bridge"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('account.group_account_user'))]"/>
        <field name="comment">Dedicated API user for Humano SISU. Do not use for daily login. API keys max 90 days.</field>
        <field name="api_key_duration">90</field>
    </record>
</odoo>
